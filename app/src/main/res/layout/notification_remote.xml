<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:background="@android:color/transparent">

    <!-- Left side: Status Dot -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingEnd="8dp"
        android:paddingStart="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/shape_dot"
            android:contentDescription="Connection Status" />
    </LinearLayout>

    <!-- Right side: Action Buttons Row -->
    <LinearLayout
        android:id="@+id/action_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_power"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_power"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Power"
            android:tint="#8A9A8A"
            android:padding="12dp" />

        <ImageButton
            android:id="@+id/btn_hazard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_hazard"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Hazard"
            android:tint="#8A9A8A"
            android:padding="12dp" />

        <ImageButton
            android:id="@+id/btn_horn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_horn"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Horn"
            android:tint="#8A9A8A"
            android:padding="12dp" />

        <ImageButton
            android:id="@+id/btn_seat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_chevron_up"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="U-Box"
            android:tint="#8A9A8A"
            android:padding="12dp" />
    </LinearLayout>

</LinearLayout>
